{
  "manifest_version": 3,
  "name": "SEOPulse - SEO Audit Tool",
  "version": "1.0.0",
  "description": "Instant SEO audit for any webpage. No API needed.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Open SEOPulse extension popup"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}